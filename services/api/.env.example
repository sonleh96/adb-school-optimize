DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@<host>:5432/postgres
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
WRITE_OPERATIONS_ENABLED=false
AUTH_REQUIRED=false
SUPABASE_JWT_AUDIENCE=authenticated
# Set only when the Supabase project still uses legacy HS256 signing.
SUPABASE_JWT_SECRET=
AUTH_ALLOWED_EMAIL_DOMAINS=adb.org
AUTH_ALLOWED_EMAILS=
WRITE_RATE_LIMIT_PER_MINUTE=10

# GCS is required for district raster overlays.
GCS_BUCKET=<bucket-name>

# For local development, prefer one of:
# 1. GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
# 2. Application Default Credentials via gcloud
# In Cloud Run, prefer workload identity instead of a JSON key file.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
GCS_PROJECT=<gcp-project-id>

# Point the API at preclipped district COGs.
# Expected object key pattern under the prefix:
#   <prefix>/<layer>/<province_norm>/<district_norm>.tif
# Example:
#   rise-png/rasters/district-clips/flood/eastern-highlands/goroka.tif
# GCS_DISTRICT_CLIP_PREFIX=rise-png/rasters/district-clips
GCS_FLOOD_DISTRICT_CLIP_PREFIX=rise-png/rasters/district-clips
GCS_LANDCOVER_DISTRICT_CLIP_PREFIX=rise-png/rasters/district-clips
GCS_LUMINOSITY_DISTRICT_CLIP_PREFIX=rise-png/rasters/district-clips
GCS_ELEVATION_DISTRICT_CLIP_PREFIX=rise-png/rasters/district-clips

GCS_FLOOD_RASTER_CRS=EPSG:4326
GCS_LANDCOVER_RASTER_CRS=EPSG:4326
GCS_LUMINOSITY_RASTER_CRS=EPSG:4326
GCS_ELEVATION_RASTER_CRS=EPSG:4326
RASTER_CACHE_DIR=/tmp/rise-png-raster-cache
RASTER_CACHE_TTL_SECONDS=3600
