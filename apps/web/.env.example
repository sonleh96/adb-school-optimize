# Leave empty to use the Next.js rewrite proxy (recommended for local UI work).
NEXT_PUBLIC_API_BASE_URL=
# Upstream FastAPI used by the rewrite when NEXT_PUBLIC_API_BASE_URL is empty.
API_PROXY_TARGET=https://rise-png-api-73728254844.asia-southeast1.run.app
# Or point the browser directly at a local API (requires CORS for your port):
# NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
NEXT_PUBLIC_WRITE_OPERATIONS_ENABLED=false
