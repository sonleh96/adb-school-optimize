# Leave empty to use the Next.js rewrite proxy (recommended for local UI work).
NEXT_PUBLIC_API_BASE_URL=
# Upstream FastAPI used by the rewrite when NEXT_PUBLIC_API_BASE_URL is empty.
# Vercel deployments use the same-origin external rewrite automatically when
# API_PROXY_TARGET is unset, so branch previews work without per-URL CORS entries.
API_PROXY_TARGET=https://rise-png-api-73728254844.asia-southeast1.run.app
# Set the browser base explicitly only when the API CORS policy allows the exact
# frontend origin and a direct browser connection is preferred:
# NEXT_PUBLIC_API_BASE_URL=https://rise-png-api-73728254844.asia-southeast1.run.app
# Or point the browser directly at a local API (requires CORS for your port):
# NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
NEXT_PUBLIC_WRITE_OPERATIONS_ENABLED=false

# Frontend authentication. Keep Supabase credentials server-only.
AUTH_REQUIRED=false
# Development only. This flag is ignored when NODE_ENV=production.
AUTH_BYPASS_LOCAL=true
SUPABASE_URL=
SUPABASE_ANON_KEY=
AUTH_ALLOWED_EMAIL_DOMAINS=adb.org
AUTH_ALLOWED_EMAILS=
# Required in production so magic links return to the correct deployment.
AUTH_SITE_URL=http://localhost:3100
