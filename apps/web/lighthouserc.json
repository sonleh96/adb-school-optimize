{
  "ci": {
    "collect": {
      "startServerCommand": "node scripts/launch-ci-app.mjs",
      "startServerReadyPattern": "CI_APP_READY",
      "url": ["http://127.0.0.1:3105/all-schools", "http://127.0.0.1:3105/district-explorer"],
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop",
        "chromeFlags": "--headless --no-sandbox --disable-dev-shm-usage",
        "blockedUrlPatterns": ["*basemaps.cartocdn.com*"]
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci/reports"
    }
  }
}
