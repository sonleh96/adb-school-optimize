{
  "name": "rise-png-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:ci-browser": "API_PROXY_TARGET=http://127.0.0.1:${CI_MOCK_API_PORT:-4100} NEXT_PUBLIC_SCREENING_TEST_HOOKS=true NEXT_PUBLIC_SCREENING_BASEMAP_STYLE=/api/v1/test/basemap-style.json next build",
    "test:e2e": "npm run build:ci-browser && playwright test",
    "bundle:check": "node scripts/check-bundle-budget.mjs",
    "analyze": "ANALYZE=true next build --webpack",
    "lighthouse": "npm run build:ci-browser && lhci autorun"
  },
  "dependencies": {
    "@deck.gl/core": "^9.4.0",
    "@deck.gl/layers": "^9.4.0",
    "@deck.gl/maplibre": "^9.4.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@supabase/ssr": "^0.12.4",
    "@tanstack/react-query": "^5.101.4",
    "@vis.gl/react-maplibre": "^8.1.3",
    "lucide-react": "^1.30.0",
    "maplibre-gl": "^6.15.0",
    "next": "16.4.2",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "@next/bundle-analyzer": "16.4.2",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.14.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.2",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "typescript": "^5.8.3",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "tmp": "0.2.7",
    "uuid": "11.1.1"
  }
}
